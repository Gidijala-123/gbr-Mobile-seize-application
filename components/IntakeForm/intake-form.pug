include ../StatCard/stat-card.pug

#dboard.tab-pane.fade.in.active.intake-form-component
  p.anim-typewriter DashBoard
  #form.form-card
    form.form-group(action='/hh',method='post')
        input(type='hidden' name='_csrf' value=csrfToken)
        center
          .col-md-4
            +statCard("fa-database", ".ttlist", "Total Mobiles", count, "stat-card--blue")
            +statCard("fa-trash", "#recycle-bin", "Recently Deleted", deletedCount, "stat-card--blue")
            label Date
            br
            input.form-control#dat2(type="Date" name="Date" required="")
            br
            br
            label Time
            br
            input.form-control#tim2(type="Time" name="Time" required="")
            br
            br
            label Student Name
            br
            input.form-control#snm2(type="text" name="sname" required="")
            br
            br
            label Parent Name
            br
            input.form-control#pnm2(type="text" name="pname" required="")
            br
            br
            label Employee Name
            br
            input.form-control#enm2(type="text" name="ename" required="")
            br
            br
            label College
            br
            select.form-control#clg2(type="" name="clg" required="")
              option ACET
              option ADTP
              option ASCS
              option T-Hub
              option Others
            br
            br

          .col-md-4
            +statCard("fa-building-o", ".tolist", "Mobiles at Office", count1, "stat-card--green")
            label Branch
            br
            select.form-control#brc2(name="brch" required="")
              option(value='MCA') MCA
              option(value='BCA') BCA
              option(value='Animation') Animation
            br
            br
            label Year of Study
            br
            input.form-control#yr2(type="text" name="year" required="")
            br
            br
            label Section
            br
            select.form-control#sec2(type="text" name="sec" required="")
              option I
              option II
              option III
            br
            br
            label Student Mobile number
            br
            input.form-control#spn2(type="number" name="spno" required="" )
            br
            br
            label Parent Mobile number
            br
            input.form-control#ppn2(type="number" name="ppno" required="" )
            br
            br
            label Employee Mobile number
            br
            input.form-control#epn2(type="number" name="epno" required="" )

          .col-md-4
            +statCard("fa-check-circle-o", ".trlist", "Returned Mobiles", count2, "stat-card--purple")
            label Roll number
            br
            input.form-control#rno2(type="text" name="rno" required="" )
            br
            br
            label Generated_ID
            br
            input.form-control#gid2(type="text" name="gid" disabled)
            br
            br
            label Employee_ID
            br
            input.form-control#eid2(type="text" name="eid" required="" )
            br
            br
            label Mobile model
            br
            input.form-control#mdl2(type="text" name="mmodel" required="" )
            br
            br
            label Mobile color
            br
            input.form-control#mcl2(type="text" name="mclr" required="" )
            br
            br
            label IMEI number
            br
            input.form-control#ime2(type="number" name="imei" placeholder="Press *#06# for IMEI number" required="" )
          .col-md-12
            label Reason
            br
            textarea.form-control#rsn2(rows="5" cols="56" placeholder="Enter proper reason for seizing" type="text" name="rsn" required="" )
            br
            br
            center
              button.pdf.btn2 Submit and Print

