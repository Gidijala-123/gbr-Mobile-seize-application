#contact.tab-pane.fade.align.contact-card-component
  p.anim-typewriter Contact Staff
  //- Institution header card
  .contact-hero
    .contact-hero-icon
      i.fa.fa-university
    .contact-hero-text
      h2.contact-inst-name Aditya College of Institutions
      p.contact-inst-tagline A place for Versatile and Experienced faculty
    .contact-hero-address
      .contact-address-item
        i.fa.fa-map-marker
        span Aditya PG College, Ayodhya Nagar
      .contact-address-item
        i.fa.fa-phone
        span 0884-2346661
      .contact-address-item
        i.fa.fa-map-pin
        span Kakinada, Andhra Pradesh — 533437

  .staff-directory(hidden)
    button#staffDirectoryBack.staff-directory-back(type="button")
      i.fa.fa-arrow-left(aria-hidden="true")
      |  All departments
    .staff-directory-heading
      .staff-directory-title
        span.staff-directory-kicker Faculty directory
        h2 Faculty and staff
        p Browse the educators referenced in the storage records.
      .staff-directory-count
        strong#staffDirectoryTotal 0
        span Faculty

    .staff-directory-toolbar
      label(for="staffDirectorySearch") Find a staff member
      .staff-search-input
        i.fa.fa-search(aria-hidden="true")
        input#staffDirectorySearch(type="search" placeholder="Search by name or employee ID" autocomplete="off")
      p#staffDirectoryStatus(role="status" aria-live="polite") Loading faculty directory

    #staffDirectoryGrid.staff-directory-grid

    p#staffDirectoryEmpty.staff-directory-empty(hidden) No faculty match that search.

  //- Department selector
  .contact-selector-section
    p.contact-selector-label
      i.fa.fa-hand-pointer-o
      |  Select Department &amp; Year to view faculty details
    .contact-dept-grid
      //- MCA cards
      .dept-card(data-dept="mca")
        .dept-card-icon
          i.fa.fa-laptop
        .dept-card-name MCA
        button.dept-directory-open(type="button" aria-label="View faculty directory from MCA")
          span View faculty
          i.fa.fa-arrow-right(aria-hidden="true")
        .dept-years
          button.year-btn(data-target="m11") 1st Yr · ACET
          button.year-btn(data-target="m12") 1st Yr · ADTP
          button.year-btn(data-target="m21") 2nd Yr · ACET
          button.year-btn(data-target="m22") 2nd Yr · ADTP
          button.year-btn(data-target="m31") 3rd Yr · ACET
          button.year-btn(data-target="m32") 3rd Yr · ADTP
      //- BCA cards
      .dept-card(data-dept="bca")
        .dept-card-icon
          i.fa.fa-code
        .dept-card-name BCA
        button.dept-directory-open(type="button" aria-label="View faculty directory from BCA")
          span View faculty
          i.fa.fa-arrow-right(aria-hidden="true")
        .dept-years
          button.year-btn(data-target="b11") 1st Yr · ACET
          button.year-btn(data-target="b12") 1st Yr · ADTP
          button.year-btn(data-target="b21") 2nd Yr · ACET
          button.year-btn(data-target="b22") 2nd Yr · ADTP
          button.year-btn(data-target="b31") 3rd Yr · ACET
          button.year-btn(data-target="b32") 3rd Yr · ADTP
      //- Animation
      .dept-card(data-dept="anim")
        .dept-card-icon
          i.fa.fa-paint-brush
        .dept-card-name Animation
        button.dept-directory-open(type="button" aria-label="View faculty directory from Animation")
          span View faculty
          i.fa.fa-arrow-right(aria-hidden="true")
        .dept-years
          button.year-btn(data-target="a11") 1st Yr · ASCS
          button.year-btn(data-target="a21") 2nd Yr · ASCS
          button.year-btn(data-target="a31") 3rd Yr · ASCS

