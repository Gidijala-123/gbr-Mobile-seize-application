#auditlist.tab-pane.fade.align.data-table-panel(class=isAuditPage ? 'in active' : null)
  p.anim-typewriter Record Activity
  .table-responsive.data-table-component
    table#auditTable.table.table-striped
      thead
        tr
          th Action
          th Roll number
          th Record ID
          th Field
          th Previous value
          th New value
          th Changed by
          th Changed at
      tbody
        each event in auditEvents || []
          tr
            td= event.actionType
            td= event.recordRno || ''
            td= event.recordId
            td= event.field
            td= event.oldValue == null ? '' : String(event.oldValue)
            td= event.newValue == null ? '' : String(event.newValue)
            td= event.changedByEmail
            td= event.changedAt
