header.header.navbar-component
  button.sidebar-toggle-box(type='button', aria-label='Toggle navigation', aria-expanded='true')
    i.fa.fa-bars.tooltips(data-placement='right', data-original-title='Toggle Navigation', aria-hidden='true')
  span.header-brand Mobile Storage Application
  .live-clock-wrap#date_time(role='status' aria-live='polite' aria-atomic='true')
    span.clock-label Today
    time#live-clock(datetime='' aria-label='Current time') 00:00:00
    span#live-date.clock-date Sep 30, 2026
  a.inner-width-neon(href='/profile')
    span.bg-width
    span.btn-text My profile
  a.inner-width-neon(href='/logout')
    span.bg-width
    span.btn-text Logout
  a.inner-width-neon(data-toggle='tab', href='#help')
    span.bg-width
    span.btn-text Help
  include ../DarkModeToggle/dark-mode-toggle.pug
  button#totpSecurityButton.security-settings-button(type="button" data-toggle="modal" data-target="#totp-security-modal" title="Two-factor authentication" aria-label="Two-factor authentication")
    i.fa.fa-shield
