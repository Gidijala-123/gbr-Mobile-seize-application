# Required application settings
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-secret
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key stable; changing it makes enrolled TOTP secrets unreadable.
TOTP_ENCRYPTION_KEY=
# Optional; comma-separated exact origins permitted to call the app cross-origin.
# Leave empty unless a separately hosted, trusted frontend requires API access.
CORS_ORIGINS=

# Request body limits (integers; defaults: JSON 1 MB, forms 5 MB, 1000 form parameters).
JSON_LIMIT_MB=1
FORM_LIMIT_MB=5
PARAMETER_LIMIT=1000

# Authentication and MongoDB runtime settings (all optional; these are the defaults).
PASSWORD_HASH_ITERATIONS=60000
MONGO_MAX_TIME_MS=10000
MONGO_WRITE_CONCERN_W=majority
MONGO_READ_PREFERENCE=primary

# SMTP settings. For Gmail, use an App Password (2-Step Verification must be enabled).
# Regular Gmail account passwords are not accepted by SMTP. Restart the app after changing credentials.
GMAIL_USER=your-email@example.com
GMAIL_PASS=your-gmail-app-password
# Optional custom SMTP transport (leave SMTP_HOST blank to use Gmail above).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Set false only for a trusted local SMTP service with a self-signed certificate.
SMTP_REJECT_UNAUTHORIZED=true
# Optional sender identity. EMAIL_FROM_ADDRESS falls back to GMAIL_USER and must be authorized by Gmail.
EMAIL_FROM_NAME=GBR Mobile Storage
EMAIL_FROM_ADDRESS=
# Optional college identity used in branded email templates (defaults match the Contact Staff page).
COLLEGE_NAME=Aditya College of Institutions
COLLEGE_ADDRESS=Aditya PG College, Ayodhya Nagar, Kakinada, Andhra Pradesh 533437
COLLEGE_PHONE=0884-2346661
# Gmail alternatives: configure Nodemailer OAuth2 refresh-token credentials in a deployment secret store,
# or replace the Gmail transport with SendGrid, Mailgun, or another SMTP provider.
PUBLIC_APP_URL=https://your-domain.example

# HTTP server settings
# Render sets PORT automatically; use 4444 for local development.
PORT=4444
NODE_ENV=production
