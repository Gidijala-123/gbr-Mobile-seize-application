html
  head
    title GBR | Mobile Storage Application — Login
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    link(href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css")
    link(rel='stylesheet' type='text/css' href='stylesheets/signlog.css')

  body(ng-app="loginapp")

    canvas#bg-canvas

    .auth-wrapper#authWrapper

      //- ── Sliding overlay (right half) ─────────────────────────────
      .overlay-container
        .overlay
          //- Left panel: shown when signup form is active
          .overlay-panel.overlay-left
            .overlay-brand
              i.fa.fa-mobile
              span MSA
            h1 Welcome Back!
            p Already have an account? Sign in to access the Mobile Storage Application dashboard.
            button.ghost-btn#signInBtn
              i.fa.fa-sign-in
              |  Sign In

          //- Right panel: shown when login form is active
          .overlay-panel.overlay-right
            .overlay-brand
              i.fa.fa-mobile
              span MSA
            h1 New Here?
            p Register to start recording and tracking mobile devices stored in your institution.
            button.ghost-btn#signUpBtn
              i.fa.fa-user-plus
              |  Create Account

      //- ── LOGIN form ───────────────────────────────────────────────
      .form-container.sign-in-container
        form(ng-controller="loginController" ng-submit="login(log)" novalidate)
          //- Animated phone illustration
          .phone-illustration
            .phone-device
              .phone-screen
            .phone-signals
              .signal-dot
              .signal-dot
              .signal-dot

          h2 Sign In
          p.form-sub Access your storage dashboard

          .input-group
            span.input-icon.fa.fa-user
            input#uname(type="text" ng-model="log.uname" placeholder="Full name" required autocomplete="off")

          .input-group
            span.input-icon.fa.fa-envelope
            input#loginname(type="email" ng-model="log.email" placeholder="Email address" required autocomplete="off")

          .input-group
            span.input-icon.fa.fa-lock
            input#password3(type="password" ng-model="log.pwd" placeholder="Password (min 10 chars)" required minlength="10" autocomplete="off")
            span.pw-toggle.fa.fa-eye.toggle-password(toggle="#password3")

          .form-links
            a.forgot-link(href="/forgot")
              i.fa.fa-key
              |  Forgot password?

          button.submit-btn(type="submit")
            span Login
            i.fa.fa-arrow-right

          .mobile-switch
            | New here?&nbsp;
            span#mobileSignupLink Create an account

      //- ── SIGNUP form ──────────────────────────────────────────────
      .form-container.sign-up-container
        form(ng-controller="signupController" ng-submit="signup(reg)" novalidate)
          h2 Create Account
          p.form-sub Join Mobile Storage Application

          .input-group
            span.input-icon.fa.fa-envelope
            input#signupname(type="email" ng-model="reg.email" placeholder="Email address" required="" autocomplete="off")

          .input-group
            span.input-icon.fa.fa-lock
            input#password1(type="password" ng-model="reg.pwd" onkeyup='check();' placeholder="Password (min 10 chars)" minlength="10" required autocomplete="off")
            span.pw-toggle.fa.fa-eye.toggle-password(toggle="#password1")

          .input-group
            span.input-icon.fa.fa-check-circle
            input#password2(type="password" ng-model="reg.pwd2" onkeyup='check();' placeholder="Confirm password" minlength="10" required autocomplete="off")
            span.pw-toggle.fa.fa-eye.toggle-password(toggle="#password2")

          #message.match-msg

          button.submit-btn(type="submit")
            span Sign Up
            i.fa.fa-arrow-right

          .mobile-switch
            | Already a member?&nbsp;
            span#mobileLoginLink Sign in

    //- hidden flipper checkbox for Angular/JS compatibility
    input#flippercheckbox.flippercheckbox(type="checkbox" name="flippercheckbox" checked hidden="" style="display:none")

  script(src="/javascripts/jquery.js")
  script(src="/javascripts/bootstrap.min.js")
  script(type="text/javascript" src="javascripts/angular.min.js")

  script.
    // ── Animated particle canvas ──────────────────────────────────────
    (function () {
      var cv = document.getElementById('bg-canvas');
      var cx = cv.getContext('2d');
      var pts = [];
      function rs() { cv.width = window.innerWidth; cv.height = window.innerHeight; }
      rs(); window.addEventListener('resize', rs);
      for (var i = 0; i < 70; i++) {
        pts.push({ x: Math.random() * cv.width, y: Math.random() * cv.height,
          r: Math.random() * 1.6 + 0.3, dx: (Math.random() - 0.5) * 0.35,
          dy: (Math.random() - 0.5) * 0.35, o: Math.random() * 0.45 + 0.12 });
      }
      function draw() {
        cx.clearRect(0, 0, cv.width, cv.height);
        pts.forEach(function (p) {
          cx.beginPath(); cx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          cx.fillStyle = 'rgba(167,243,208,' + p.o + ')'; cx.fill();
          p.x += p.dx; p.y += p.dy;
          if (p.x < 0 || p.x > cv.width) p.dx *= -1;
          if (p.y < 0 || p.y > cv.height) p.dy *= -1;
        });
        requestAnimationFrame(draw);
      }
      draw();
    })();

    // ── Overlay panel toggle ──────────────────────────────────────────
    var wr = document.getElementById('authWrapper');
    document.getElementById('signUpBtn').addEventListener('click', function () {
      wr.classList.add('right-panel-active');
    });
    document.getElementById('signInBtn').addEventListener('click', function () {
      wr.classList.remove('right-panel-active');
    });
    var msl = document.getElementById('mobileSignupLink');
    var mll = document.getElementById('mobileLoginLink');
    if (msl) msl.addEventListener('click', function () { wr.classList.add('right-panel-active'); });
    if (mll) mll.addEventListener('click', function () { wr.classList.remove('right-panel-active'); });

    // ── Password toggle (eye icon) ────────────────────────────────────
    $('.toggle-password').on('click', function () {
      $(this).toggleClass('fa-eye fa-eye-slash');
      var inp = $($(this).attr('toggle'));
      inp.attr('type', inp.attr('type') === 'password' ? 'text' : 'password');
    });

    // ── Password match indicator ──────────────────────────────────────
    function updatePasswordMessage() {
      var msg = document.getElementById('message');
      if (!msg) return;
      var p1 = document.getElementById('password1');
      var p2 = document.getElementById('password2');
      var v1 = p1 ? p1.value : '', v2 = p2 ? p2.value : '';
      if (!v1 && !v2) { msg.innerHTML = ''; msg.className = 'match-msg'; return; }
      if (v1 === v2 && v1.length >= 10) {
        msg.className = 'match-msg match';
        msg.innerHTML = '<i class="fa fa-check-circle"></i> Passwords match';
      } else {
        msg.className = 'match-msg no-match';
        msg.innerHTML = '<i class="fa fa-times-circle"></i> ' +
          (v1.length < 10 ? 'Minimum 10 characters required' : 'Passwords do not match');
      }
    }
    function check() { updatePasswordMessage(); }
    var ip1 = document.getElementById('password1'), ip2 = document.getElementById('password2');
    if (ip1) ip1.addEventListener('input', updatePasswordMessage);
    if (ip2) ip2.addEventListener('input', updatePasswordMessage);

  script.
    var app = angular.module('loginapp', []);

    app.controller('signupController', function ($scope, $http) {
      $scope.signup = function (reg) {
        if (!reg || !reg.email || !reg.pwd || reg.pwd !== reg.pwd2) {
          alert('Please enter a valid email and matching passwords.');
          return;
        }
        $http({ method: 'POST', url: '/postsignup', data: { email: reg.email, pwd: reg.pwd }
        }).then(function () {
          $scope.reg = {};
          alert("Registered successfully! \uD83E\uDD97");
        }, function (res) { alert(res.data || 'Unable to create your account.'); });
      };
    });

    app.controller('loginController', function ($scope, $http, $window) {
      $scope.login = function (log) {
        $http({ method: 'POST', url: '/postlogin',
          data: { uname: log.uname, email: log.email, pwd: log.pwd }
        }).then(function () {
          alert('Welcome, ' + log.uname + '! \uD83D\uDCF1\nRedirecting to dashboard...');
          $window.location.href = '/home';
        }, function (res) { $scope.log = {}; alert(res.data || 'Invalid credentials.'); });
      };
    });
