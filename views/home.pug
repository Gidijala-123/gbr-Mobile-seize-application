      include ../components/Navbar/navbar.pug

      include ../components/Sidebar/sidebar.pug
      section#main-content
        section.wrapper
          .col-md-12
            .tab-content

              include ../components/IntakeForm/intake-form.pug
              include ../components/DataTable/total-list.pug
              include ../components/DataTable/office-list.pug
              include ../components/DataTable/returned-list.pug
              include ../components/DataTable/recycle-bin.pug
              include audit.pug
              include ../components/SearchBar/search-bar.pug
              include ../components/ContactCard/contact-card.pug
              include ../components/HelpSection/help-section.pug
    include ../components/AccountSecurity/account-security.pug
    include ../components/Toast/toast.pug
    include ../components/ConfirmModal/confirm-modal.pug
    include ../components/Footer/footer.pug
