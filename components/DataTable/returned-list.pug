include data-table.pug

#returnedlist.tab-pane.fade.align.trlist.data-table-panel
  p.anim-typewriter List of Mobiles Returned
  +responsiveTable()
    table#example4.table.table-striped
      thead
        tr
          th Date
          th Time
          th Generated_ID
          th RollNo
          th Stud_name
          th College
          th Branch
          th Year
          th Section
          th Stud_phno
          th Parent_name
          th Parent_phno
          th Mobile_model
          th IMEI_number
          th Mobile_color
          th Reason
          th Employee_name
          th Employee_phno
          th Employee_ID
          th Photo
          th Action
      tbody
        each member in data2
          tr(data-device-photos=member.devicePhotos && member.devicePhotos.length ? JSON.stringify(member.devicePhotos) : '')
            td #{member.Date}
            td #{member.Time}
            td #{member._id}
            td #{member.rno}
            td #{member.sname}
            td #{member.clg}
            td #{member.brch}
            td #{member.year}
            td #{member.sec}
            td #{member.spno}
            td #{member.pname}
            td #{member.ppno}
            td #{member.mmodel}
            td #{member.imei}
            td #{member.mclr}
            td #{member.rsn}
            td #{member.ename}
            td #{member.epno}
            td #{member.eid}
            td
              if member.devicePhotos && member.devicePhotos.length
                .device-table-thumb-strip
                  each photo in member.devicePhotos.slice(0, 3)
                    img.device-table-thumb(src=photo alt='Device photo thumbnail')
              else
                span.device-table-no-photo —
            td
              button.row-details-toggle(type="button" aria-expanded="false" aria-label="Expand record details" title="Expand record details")
                i.fa.fa-plus(aria-hidden="true")
              button.del-btn(data-action='delete' data-record-id=member._id data-rno=member.rno data-name=member.sname title="Delete record")
                i.fa.fa-trash

