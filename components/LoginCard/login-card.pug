canvas#bg-canvas

.auth-wrapper#authWrapper.login-card-component

  //- ── Sliding overlay (right half) ─────────────────────────────
  .overlay-container
    .overlay
      //- Left panel: shown when signup form is active
      .overlay-panel.overlay-left
        .overlay-brand
          i.fa.fa-mobile
          span MSA
        h1 Welcome Back!
        p Already have an account? Sign in to access the Mobile Storage Application dashboard.
        button.ghost-btn#signInBtn
          i.fa.fa-sign-in
          |  Sign In

      //- Right panel: shown when login form is active
      .overlay-panel.overlay-right
        .overlay-brand
          i.fa.fa-mobile
          span MSA
        h1 New Here?
        p Register to start recording and tracking mobile devices stored in your institution.
        button.ghost-btn#signUpBtn
          i.fa.fa-user-plus
          |  Create Account

  //- ── LOGIN form ───────────────────────────────────────────────
  .form-container.sign-in-container
    form#login-form(novalidate)
      //- Animated phone illustration
      .phone-illustration
        .phone-device
          .phone-screen
        .phone-signals
          .signal-dot
          .signal-dot
          .signal-dot

      h2 Sign In
      p.form-sub Access your storage dashboard

      .input-group(data-login-primary)
        span.input-icon.fa.fa-envelope
        input#loginname(type="email" name="email" aria-label="Email address" placeholder="Email address" required autocomplete="username")

      .input-group(data-login-primary)
        span.input-icon.fa.fa-lock
        input#password3(type="password" name="pwd" aria-label="Password" placeholder="Password (min 10 chars)" required minlength="10" autocomplete="current-password")
        button.pw-toggle.toggle-password(type="button" toggle="#password3" aria-label="Show password" aria-pressed="false")
          i.fa.fa-eye(aria-hidden="true")

      .input-group#totp-login-group(hidden)
        span.input-icon.fa.fa-shield
        input#totpLoginCode(type="text" name="code" aria-label="Authenticator or recovery code" placeholder="6-digit authenticator code" inputmode="numeric" maxlength="16" autocomplete="one-time-code" required)

      button.forgot-link#toggle-recovery(type="button" hidden)
        | Use a recovery code

      //- Error message only (below inputs, not as floating bar)
      p.login-error-msg#login-error-msg(hidden role="alert" aria-live="assertive")
        i.fa.fa-exclamation-circle

      .form-links(data-login-primary)
        a.forgot-link(href="/forgot")
          i.fa.fa-key
          |  Forgot password?

      //- Button: 3 states — default / loading / success
      button.submit-btn.login-btn(
        type="submit"
        id="login-submit"
      )
        //- Default state
        span.login-btn-default#login-btn-default
          | Login
          i.fa.fa-arrow-right
        //- Loading state
        span.login-btn-loading#login-btn-loading(hidden)
          span.login-spinner
          | Signing in...
        //- Success state
        span.login-btn-success#login-btn-success(hidden)
          i.fa.fa-check
          | Redirecting...

      .mobile-switch
        | New here?&nbsp;
        button#mobileSignupLink.mobile-switch-link(type="button") Create an account

  //- ── SIGNUP form ──────────────────────────────────────────────
  .form-container.sign-up-container
    form#signup-form(novalidate)
      h2 Create Account
      p.form-sub Join Mobile Storage Application

      .input-group
        span.input-icon.fa.fa-envelope
        input#signupname(type="email" name="email" aria-label="Email address" placeholder="Email address" required autocomplete="email")

      .input-group
        span.input-icon.fa.fa-lock
        input#password1(type="password" name="pwd" aria-label="Password" placeholder="Password (upper, lower, number, symbol)" minlength="10" maxlength="128" required autocomplete="new-password")
        button.pw-toggle.toggle-password(type="button" toggle="#password1" aria-label="Show password" aria-pressed="false")
          i.fa.fa-eye(aria-hidden="true")

      .password-strength-wrap
        .password-strength-bar
          span#password-strength-fill
        .password-strength-meta
          span#password-strength-label Password strength: Waiting...
          span#password-strength-hint Minimum 10 chars, mixed case, number, symbol

      .input-group
        span.input-icon.fa.fa-check-circle
        input#password2(type="password" name="pwd2" aria-label="Confirm password" placeholder="Confirm password" minlength="10" maxlength="128" required autocomplete="new-password")
        button.pw-toggle.toggle-password(type="button" toggle="#password2" aria-label="Show password" aria-pressed="false")
          i.fa.fa-eye(aria-hidden="true")

      p.password-policy-hint Use 10-128 characters with uppercase, lowercase, a number, and a symbol.

      #message.match-msg(role="status" aria-live="polite")

      button.submit-btn(type="submit" id="signupSubmitBtn" disabled)
        span Sign Up
        i.fa.fa-arrow-right

      .mobile-switch
        | Already a member?&nbsp;
        button#mobileLoginLink.mobile-switch-link(type="button") Sign in





