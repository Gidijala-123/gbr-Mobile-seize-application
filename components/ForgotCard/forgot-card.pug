.forgot-wrap.forgot-card-component
  .forgot-card
    h1 Forgot Password
    hr
    p.sub-desc Enter your registered email address and we'll send a password reset OTP to your inbox.
    form#reset-request-form.form-group(novalidate)
      .fg-field
        span.fg-icon.fa.fa-envelope
        input#forgot-email.form-control(type="email" aria-label="Registered email address" placeholder="Enter your registered email" required autocomplete="email")
      .note-box
        b Note:
        |  &nbsp;Please enter the email you used to register your account.
      button.btn-send(type="submit")
        i.fa.fa-paper-plane(style="margin-right:6px;")
        | Send OTP

    form#reset-verify-form.form-group(hidden novalidate)
      p.note-box If an account exists for this email, a 6-digit code has been sent. The code expires in 10 minutes.
      .fg-field
        span.fg-icon.fa.fa-envelope
        input#reset-email.form-control(type="email" aria-label="Registered email" readonly)
      .fg-field
        span.fg-icon.fa.fa-key
        input#reset-otp.form-control(type="text" aria-label="Six-digit password reset code" placeholder="6-digit reset code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code")
      .fg-field
        span.fg-icon.fa.fa-lock
        input#reset-password.form-control(type="password" aria-label="New password" placeholder="New password (upper, lower, number, symbol)" minlength="10" maxlength="128" required autocomplete="new-password")
      .fg-field
        span.fg-icon.fa.fa-lock
        input#reset-confirm-password.form-control(type="password" aria-label="Confirm new password" placeholder="Confirm new password" required autocomplete="new-password")
      button.btn-send(type="submit")
        i.fa.fa-check(style="margin-right:6px;")
        | Reset Password
      button#resend-reset-otp.btn-send(type="button" style="margin-top:10px;")
        i.fa.fa-refresh(style="margin-right:6px;")
        | Send another OTP
      button#use-another-email.back-link(type="button" style="display:block; margin:14px auto 0; border:0; background:none; cursor:pointer;") Use a different email

    .back-wrap
      a.back-link(href="/")
        i.fa.fa-chevron-left
        | Back to Login
