    link(rel='stylesheet', href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css')
    link(href='https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap' rel='stylesheet')
    link(href='https://fonts.googleapis.com/css2?family=Source+Code+Pro:wght@400;700&family=Lato:wght@300;400;700&display=swap' rel='stylesheet')
    include components/component-styles.pug

  body.home-body(class=darkMode ? "dark-mode" : null, data-db-error=databaseError, data-session-expires-at=sessionExpiresAt || 0, data-session-ttl-ms=sessionTtlMs || 28800000, data-user-authenticated=sessionUser ? 'true' : 'false')
    a.skip-link(href="#main-content") Skip to main content
    if sessionUser
      include ../components/SessionWarning/session-warning.pug
    .dashboard-loading-skeleton(aria-live="polite" aria-busy="true")
      .dashboard-loading-shell
        .dashboard-loading-grid
          .dashboard-loading-card
          .dashboard-loading-card
          .dashboard-loading-card
        .dashboard-loading-table
          .dashboard-loading-table-head
          .dashboard-loading-table-body
            span
            span
            span
            span
    .table-loading-skeleton(aria-live="polite" aria-busy="true")
      .table-loading-header
      .table-loading-row
      .table-loading-row
      .table-loading-row
    section#container
      include ../components/Navbar/navbar.pug

      include ../components/Sidebar/sidebar.pug
      section#main-content
        section.wrapper
          .col-md-12
            .tab-content

              include ../components/IntakeForm/intake-form.pug
              include ../components/AnalyticsChart/analytics-chart.pug
              include ../components/DataTable/total-list.pug
              include ../components/DataTable/office-list.pug
              include ../components/DataTable/returned-list.pug
              include ../components/DataTable/recycle-bin.pug
              include audit.pug
              include ../components/SearchBar/search-bar.pug
              include ../components/ContactCard/contact-card.pug
              include ../components/HelpSection/help-section.pug
    include ../components/AccountSecurity/account-security.pug
    include ../components/Toast/toast.pug
    if flashMessages && flashMessages.length
      script.
        document.addEventListener('DOMContentLoaded', function () {
          if (!window.GBR || !GBR.toast) return;
          flashMessages.forEach(function (item) {
            var type = item.type === 'error' ? 'error' : item.type === 'warning' ? 'warning' : item.type === 'success' ? 'success' : 'info';
            GBR.toast[type](item.message);
          });
        });
    include ../components/ConfirmModal/confirm-modal.pug
    include ../components/RecordDetailModal/record-detail-modal.pug
    include ../components/ReturnWorkflowModal/return-workflow-modal.pug
    include ../components/Footer/footer.pug
    // js placed at the end of the document so the pages load faster
    script(src='/vendor/jquery/jquery.min.js?v=3.7.1', integrity='sha384-1H217gwSVyLSIfaLxHbE7dRb3v4mYCKbpQvzx0cegeju1MVsGrX5xXxAvs/HgeFs', crossorigin='anonymous')
