canvas#bg-canvas

.auth-wrapper#authWrapper.login-card-component

  //- ── Sliding overlay (right half) ─────────────────────────────
  .overlay-container
    .overlay
      //- Left panel: shown when signup form is active
      .overlay-panel.overlay-left
        .overlay-brand
          i.fa.fa-mobile
          span MSA
        h1 Welcome Back!
        p Already have an account? Sign in to access the Mobile Storage Application dashboard.
        button.ghost-btn#signInBtn
          i.fa.fa-sign-in
          |  Sign In

      //- Right panel: shown when login form is active
      .overlay-panel.overlay-right
        .overlay-brand
          i.fa.fa-mobile
          span MSA
        h1 New Here?
        p Register to start recording and tracking mobile devices stored in your institution.
        button.ghost-btn#signUpBtn
          i.fa.fa-user-plus
          |  Create Account

  //- ── LOGIN form ───────────────────────────────────────────────
  .form-container.sign-in-container
    form(ng-controller="loginController" ng-submit="login(log)" novalidate)
      //- Animated phone illustration
      .phone-illustration
        .phone-device
          .phone-screen
        .phone-signals
          .signal-dot
          .signal-dot
          .signal-dot

      h2 Sign In
      p.form-sub Access your storage dashboard

      .input-group(ng-show="loginStep !== 'totp'")
        span.input-icon.fa.fa-envelope
        input#loginname(type="email" ng-model="log.email" placeholder="Email address" required autocomplete="off" ng-disabled="loginLoading")

      .input-group(ng-show="loginStep !== 'totp'")
        span.input-icon.fa.fa-lock
        input#password3(type="password" ng-model="log.pwd" placeholder="Password (min 10 chars)" required minlength="10" autocomplete="off" ng-disabled="loginLoading")
        span.pw-toggle.fa.fa-eye.toggle-password(toggle="#password3")

      .input-group(ng-show="loginStep === 'totp'")
        span.input-icon.fa.fa-shield
        input#totpLoginCode(type="text" ng-model="loginCode" ng-attr-placeholder="{{loginUsingRecovery ? 'Recovery code' : '6-digit authenticator code'}}" inputmode="numeric" maxlength="16" autocomplete="one-time-code" ng-disabled="loginLoading" required)

      button.forgot-link(type="button" ng-show="loginStep === 'totp'" ng-click="loginUsingRecovery = !loginUsingRecovery")
        | {{loginUsingRecovery ? 'Use authenticator code' : 'Use a recovery code'}}

      //- Error message only (below inputs, not as floating bar)
      p.login-error-msg(ng-show="loginStatus === 'error'")
        i.fa.fa-exclamation-circle
        |  {{loginMsg}}

      .form-links(ng-show="loginStep !== 'totp'")
        a.forgot-link(href="/forgot")
          i.fa.fa-key
          |  Forgot password?

      //- Button: 3 states — default / loading / success
      button.submit-btn.login-btn(
        type="submit"
        ng-disabled="loginLoading || loginStatus === 'success'"
        ng-class="{'login-btn--loading': loginStatus === 'loading', 'login-btn--success': loginStatus === 'success'}"
      )
        //- Default state
        span.login-btn-default(ng-show="!loginStatus || loginStatus === 'error'")
          | {{loginStep === 'totp' ? 'Verify code' : 'Login'}}
          i.fa.fa-arrow-right
        //- Loading state
        span.login-btn-loading(ng-show="loginStatus === 'loading'")
          span.login-spinner
          | Signing in...
        //- Success state
        span.login-btn-success(ng-show="loginStatus === 'success'")
          i.fa.fa-check
          | Redirecting...

      .mobile-switch
        | New here?&nbsp;
        span#mobileSignupLink Create an account

  //- ── SIGNUP form ──────────────────────────────────────────────
  .form-container.sign-up-container
    form(ng-controller="signupController" ng-submit="signup(reg)" novalidate)
      h2 Create Account
      p.form-sub Join Mobile Storage Application

      .input-group
        span.input-icon.fa.fa-envelope
        input#signupname(type="email" ng-model="reg.email" placeholder="Email address" required="" autocomplete="off")

      .input-group
        span.input-icon.fa.fa-lock
        input#password1(type="password" ng-model="reg.pwd" placeholder="Password (upper, lower, number, symbol)" minlength="10" maxlength="128" required autocomplete="new-password")
        span.pw-toggle.fa.fa-eye.toggle-password(toggle="#password1")

      .input-group
        span.input-icon.fa.fa-check-circle
        input#password2(type="password" ng-model="reg.pwd2" placeholder="Confirm password" minlength="10" maxlength="128" required autocomplete="new-password")
        span.pw-toggle.fa.fa-eye.toggle-password(toggle="#password2")

      p.password-policy-hint Use 10-128 characters with uppercase, lowercase, a number, and a symbol.

      #message.match-msg

      button.submit-btn(type="submit")
        span Sign Up
        i.fa.fa-arrow-right

      .mobile-switch
        | Already a member?&nbsp;
        span#mobileLoginLink Sign in

//- hidden flipper checkbox for Angular/JS compatibility
input#flippercheckbox.flippercheckbox(type="checkbox" name="flippercheckbox" checked hidden="" style="display:none")
