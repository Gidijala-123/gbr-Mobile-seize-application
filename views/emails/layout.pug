doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    title GBR Mobile Storage
  body(style="margin:0;padding:24px;background:#f1f5f9;font-family:Arial,sans-serif;color:#172033")
    span(style="display:none!important;visibility:hidden;opacity:0;color:transparent;height:0;width:0;overflow:hidden;mso-hide:all")= preheader
    table(role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #dbe4ed;border-radius:8px")
      tr
        td(style="padding:24px 28px 12px;border-bottom:3px solid #0f766e")
          p(style="margin:0;color:#0f766e;font-size:12px;font-weight:bold;letter-spacing:1px;text-transform:uppercase") GBR Mobile Storage
          h1(style="margin:8px 0 0;font-size:22px;line-height:1.3;color:#172033")= collegeName
      tr
        td(style="padding:24px 28px")
          block content
      tr
        td(style="padding:16px 28px 20px;border-top:1px solid #e2e8f0;color:#526174;font-size:12px;line-height:1.6")
          strong(style="color:#172033")= collegeName
          br
          = collegeAddress
          br
          | Phone:
          a(href="tel:" + collegePhone.replace(/[^+\d]/g, "") style="color:#0f766e;text-decoration:none")= collegePhone